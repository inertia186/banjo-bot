# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. Defaults to "$" to match the legacy bot.
COMMAND_PREFIX=$

# Optional. Space-separated channel names or IDs to restrict message commands.
CHANNELS=

# Optional. Useful for local smoke testing or deploy logs.
LOG_LEVEL=info

# Optional. Enable lightweight LLM replies when Banjo is mentioned or DM'd.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_HISTORY=8
LLM_MAX_OUTPUT_TOKENS=180
OPENAI_API_KEY=
