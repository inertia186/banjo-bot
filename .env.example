# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. Defaults to "$" to match the legacy bot.
COMMAND_PREFIX=$

# Optional. Space-separated channel names or IDs to restrict message commands.
CHANNELS=

# Optional. Useful for local smoke testing or deploy logs.
LOG_LEVEL=info

# Optional. Space- or comma-separated Hive JSON-RPC nodes.
HIVE_NODES=https://api.hive.blog https://api.deathwing.me
HIVE_NODES_SOURCE_URL=https://developers.hive.io/quickstart/hive_full_nodes.html

# Optional. HAF Block Explorer PostgREST base URL for future historical lookups.
HAFBE_BASE_URL=

# Optional. Enable HiveSQL-backed wildcard account lookups, e.g. $mvests inertia*
HIVESQL_ENABLED=false
HIVESQL_HOST=sql.hivesql.io
HIVESQL_DATABASE=DBHive
HIVESQL_USERNAME=
HIVESQL_PASSWORD=
HIVESQL_WILDCARD_LIMIT=50

# Optional. CoinGecko API base URL for market-price lookups.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional. Hive Engine smart contract RPC endpoint.
HIVE_ENGINE_CONTRACTS_URL=https://api.hive-engine.com/rpc/contracts

# Optional. SCOT API base URL for tribe/tag metadata.
SCOT_API_URL=https://scot-api.hive-engine.com

# Optional. Enable lightweight LLM replies when Banjo is mentioned or DM'd.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_HISTORY=8
LLM_MAX_OUTPUT_TOKENS=180
OPENAI_API_KEY=

# Optional. Hyperion digest context for current Hive LLM replies.
HYPERION_BASE_URL=https://www.hyperion.zone
HYPERION_BEARER_TOKEN=
HYPERION_DIGEST_LIMIT=10
BANJO_OWNER_IDS=237384510096801792
