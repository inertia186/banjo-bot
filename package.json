{
  "name": "banjo-bot",
  "version": "2.0.0",
  "description": "A modern reimplementation of the Banjo Discord bot.",
  "license": "CC0-1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run build && npm run test",
    "smoke:hafsql": "tsx scripts/hafsql-smoke.ts"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "mssql": "^12.5.4",
    "openai": "^4.104.0",
    "pg": "^8.21.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.15.18",
    "@types/pg": "^8.20.0",
    "typescript": "^5.8.3"
  }
}
